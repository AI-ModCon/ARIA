{
  "profileId": "core-v4-minimal",
  "version": "4.0.0-draft",
  "description": "Minimal mandatory GMP core profile for v4 deployments: identity, registry, policy, runs, events. All other surface ships as named optional modules (see core-v4-modules.json). Proposed by RFC 016.",
  "requiredApiSpec": "../openapi/gmp-core-v4.yaml",
  "requiredOperations": [
    "establishSession",
    "mintCapabilityToken",
    "revokeCapabilityToken",
    "getCapabilityTokenAudit",
    "listCapabilities",
    "registerCapability",
    "getCapability",
    "evaluatePolicy",
    "submitRun",
    "getRun",
    "cancelRun",
    "retryRun",
    "appendEvent",
    "listEvents"
  ],
  "requiredSchemas": [
    "../schemas/common/identity-session.schema.json",
    "../schemas/common/identity-claims.schema.json",
    "../schemas/common/capability.schema.json",
    "../schemas/common/capability-token.schema.json",
    "../schemas/common/revocation.schema.json",
    "../schemas/common/policy-decision.schema.json",
    "../schemas/common/structured-error.schema.json",
    "../schemas/common/workflow-state.schema.json",
    "../schemas/common/journal-event.schema.json",
    "../schemas/v4/run.schema.json",
    "../schemas/v4/execution-context.schema.json",
    "../schemas/v4/run-lifecycle-event.schema.json",
    "../schemas/events/event-envelope-base.schema.json",
    "../schemas/events/failure-taxonomy.schema.json",
    "../schemas/v4/event-envelope.schema.json",
    "../schemas/v4/journal-envelope-event.schema.json"
  ],
  "reproducibilityTiers": {
    "tier1_declared": {
      "description": "Capability is declared with valid metadata and references."
    },
    "tier2_smoke_tested": {
      "description": "Capability executable artifact passes clean-profile smoke test."
    },
    "tier3_independently_replicated": {
      "description": "Capability replication passes structured agreement checks on independent hardware."
    }
  },
  "complianceChecks": [
    "openapi_valid",
    "all_refs_resolve",
    "required_operations_present",
    "failure_taxonomy_consistent",
    "schema_examples_present",
    "identity_revocation_enforced",
    "idempotency_required_on_mutations"
  ],
  "extensionPolicy": {
    "allowed": true,
    "namespaceRule": "Extensions must use x-gmp-* fields or /v4/experimental/* routes.",
    "coreCompatibilityRequired": true
  }
}
