{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/common/policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "required": ["decision", "rationaleCode", "obligations"],
  "properties": {
    "decision": { "type": "string", "enum": ["allow", "deny", "conditional"] },
    "rationaleCode": { "type": "string", "minLength": 1 },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string", "enum": ["mfa", "human_approval", "data_masking", "time_window"] },
          "value": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "providerEnforcement": { "type": "string", "enum": ["required", "not_required"] }
  },
  "additionalProperties": false
}
