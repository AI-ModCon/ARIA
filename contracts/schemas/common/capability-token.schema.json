{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/common/capability-token.schema.json",
  "title": "CapabilityToken",
  "type": "object",
  "required": ["tokenId", "subject", "intent", "scope", "issuedAt", "expiresAt", "delegation"],
  "properties": {
    "tokenId": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "intent": { "$ref": "./delegation-intent.schema.json" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "delegation": { "$ref": "./identity-claims.schema.json" },
    "revocationRef": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
