{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/common/usage-meter.schema.json",
  "title": "UsageMeter",
  "type": "object",
  "required": ["taskId", "tenantId", "modelTokens", "toolCalls", "externalSpendUsd", "recordedAt"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "modelTokens": { "type": "integer", "minimum": 0 },
    "toolCalls": { "type": "integer", "minimum": 0 },
    "externalSpendUsd": { "type": "number", "minimum": 0 },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
