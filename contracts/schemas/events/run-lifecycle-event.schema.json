{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/events/run-lifecycle-event.schema.json",
  "title": "RunLifecycleEvent",
  "allOf": [
    { "$ref": "./event-envelope-base.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "enum": [
            "run.submitted",
            "run.started",
            "run.target_failed",
            "run.retry",
            "run.completed",
            "run.failed",
            "run.cancelled"
          ],
          "description": "run.cancelled records an initiator-driven transition from queued or running to cancelled: payload.status MUST be 'cancelled' and payload.failureClass MUST be 'F0_NONE', because cancellation is not a failure. Implementations cancelling because an upstream step failed emit run.failed with the appropriate failureClass instead. An ExecutionAttempt with status 'cancelled' records one external task being cancelled and is a distinct, attempt-level record. (RFC 010)"
        },
        "payload": {
          "type": "object",
          "required": ["runId", "capabilityId", "status", "failureClass"],
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "capabilityId": { "type": "string", "minLength": 1 },
            "status": {
              "type": "string",
              "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
            },
            "failureClass": { "$ref": "./failure-taxonomy.schema.json" },
            "targetOutcomes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["targetId", "state"],
                "properties": {
                  "targetId": { "type": "string" },
                  "state": { "type": "string", "enum": ["submitted", "running", "failed", "succeeded", "skipped"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["eventType", "payload"]
    }
  ]
}
