{
  "profileId": "core-v2",
  "version": "2.0.0",
  "description": "Mandatory GMP core profile for v2 agent-native deployments.",
  "requiredApiSpec": "../openapi/gmp-core-v2.yaml",
  "requiredOperations": [
    "mintCapabilityToken",
    "revokeCapabilityToken",
    "getCapabilityTokenAudit",
    "planRun",
    "pauseRun",
    "resumeRun",
    "listRunCheckpoints",
    "writeMemoryRecord",
    "queryMemoryRecords",
    "summarizeMemoryRecords",
    "forgetMemoryRecords",
    "getTaskUsage",
    "allocateBudget",
    "enforceBudget",
    "runEval",
    "getEvalResult",
    "sendAgentMessage",
    "handoffAgentTask",
    "resolveAgentConsensus",
    "proposeAction",
    "approveAction",
    "applyAction",
    "rollbackAction",
    "listSupervisionQueue",
    "recordIntervention",
    "listDivergenceAlerts",
    "listReasoningEvents"
  ],
  "requiredSchemas": [
    "../schemas/common/capability-token.schema.json",
    "../schemas/common/delegation-intent.schema.json",
    "../schemas/common/revocation.schema.json",
    "../schemas/common/negotiation-hint.schema.json",
    "../schemas/common/structured-error.schema.json",
    "../schemas/common/cost-latency-hint.schema.json",
    "../schemas/common/workflow-state.schema.json",
    "../schemas/common/checkpoint.schema.json",
    "../schemas/common/resume-token.schema.json",
    "../schemas/common/memory-record.schema.json",
    "../schemas/common/memory-policy.schema.json",
    "../schemas/common/memory-sharing.schema.json",
    "../schemas/common/usage-meter.schema.json",
    "../schemas/common/budget-policy.schema.json",
    "../schemas/common/model-routing-policy.schema.json",
    "../schemas/common/eval-result.schema.json",
    "../schemas/common/agent-message.schema.json",
    "../schemas/common/handoff.schema.json",
    "../schemas/common/consensus-decision.schema.json",
    "../schemas/common/sandbox-policy.schema.json",
    "../schemas/common/side-effect-manifest.schema.json",
    "../schemas/common/approval-gate.schema.json",
    "../schemas/common/supervision-queue-item.schema.json",
    "../schemas/common/divergence-alert.schema.json",
    "../schemas/common/intervention-record.schema.json",
    "../schemas/events/reasoning-node-event.schema.json",
    "../schemas/events/tool-call-event.schema.json"
  ],
  "complianceChecks": [
    "openapi_valid",
    "all_refs_resolve",
    "required_operations_present",
    "identity_revocation_enforced",
    "idempotency_required_on_mutations",
    "durable_execution_resume_replay_safe",
    "memory_policy_enforced",
    "budget_policy_enforced",
    "reasoning_trace_queryable",
    "sandbox_gate_apply_rollback_validated",
    "supervision_workflows_validated",
    "schema_examples_present"
  ],
  "extensionPolicy": {
    "allowed": true,
    "namespaceRule": "Extensions must use x-gmp-* fields or /v2/experimental/* routes.",
    "coreCompatibilityRequired": true
  },
  "migration": {
    "fromProfileId": "core-v1",
    "compatibilityMode": "dual-stack",
    "deprecationPolicy": "v1 remains supported until two stable v2 releases complete."
  }
}
