{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/common/handoff.schema.json",
  "title": "Handoff",
  "type": "object",
  "required": ["handoffId", "fromAgentId", "toAgentId", "taskRef", "reason", "createdAt"],
  "properties": {
    "handoffId": { "type": "string", "minLength": 1 },
    "fromAgentId": { "type": "string", "minLength": 1 },
    "toAgentId": { "type": "string", "minLength": 1 },
    "taskRef": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
