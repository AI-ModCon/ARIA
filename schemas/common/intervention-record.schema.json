{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/common/intervention-record.schema.json",
  "title": "InterventionRecord",
  "type": "object",
  "required": ["interventionId", "queueItemId", "actor", "action", "recordedAt"],
  "properties": {
    "interventionId": { "type": "string", "minLength": 1 },
    "queueItemId": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["approve", "reject", "pause", "resume", "escalate"] },
    "recordedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
