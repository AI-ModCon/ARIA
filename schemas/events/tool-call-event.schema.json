{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmp.dev/contracts/schemas/events/tool-call-event.schema.json",
  "title": "ToolCallEvent",
  "allOf": [
    { "$ref": "./event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "enum": ["tool.call"] },
        "payload": {
          "type": "object",
          "required": ["runId", "toolName", "status", "latencyMs", "tokenCost"],
          "properties": {
            "runId": { "type": "string", "minLength": 1 },
            "toolName": { "type": "string", "minLength": 1 },
            "status": { "type": "string", "enum": ["started", "succeeded", "failed"] },
            "latencyMs": { "type": "integer", "minimum": 0 },
            "tokenCost": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "required": ["eventType", "payload"]
    }
  ]
}
